{
  "name": "@reyhanfahlevi/homeassistant-mcp",
  "version": "0.1.0",
  "description": "MCP server for the Home Assistant REST API using a long-lived access token.",
  "type": "module",
  "bin": {
    "homeassistant-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsx src/format.test.ts",
    "smoke": "tsx src/smoke.ts",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "home-assistant",
    "homeassistant",
    "smarthome",
    "modelcontextprotocol"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
